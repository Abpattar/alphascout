# AlphaScout environment configuration
# Copy to .env and fill in your keys. Never commit the real .env.

# ── AI Providers ─────────────────────────────────────────────────────
# Groq (primary; supports multiple comma-separated keys for rotation)
GROQ_API_KEY=gsk_yourkey1,gsk_yourkey2

# OpenRouter (fallback #2)
OPENROUTER_API_KEY=sk-or-yourkey

# Cerebras (fallback #3)
CEREBRAS_API_KEY=csk-yourkey

# Gemini / Google AI Studio (fallback #4)
GEMINI_API_KEY=yourkey

# NVIDIA NIM (last-resort retry)
NVIDIA_NIM_API_KEY=nvapi-yourkey

# ── Telegram (manual trade tracking bot) ────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Numeric chat id of YOUR chat with the bot (personal_use_only enforces it)
TELEGRAM_CHAT_ID=123456789
